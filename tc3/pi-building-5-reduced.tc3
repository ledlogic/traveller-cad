title: The Pi Building - Fifth (SQUISHED, seam at x=0, 4-panel print layout)
units: m
world: -40, -24, 40, 24
grid: 1.5
wallwidth: 0.3
wallcolor: #1e4a6e

# ── FIFTH FLOOR (60m x 36m -- exact match for 4 panels @ 20x12in x 1.5m/in,
# zero overhang. Towers centered at x=-15/+15, y=0; 13.5m gap between them,
# seam at x=0 sits symmetrically 6.75m from each tower.)
rect: -30, -18, 30, 18

# ── CENTRAL CORRIDOR ─
rect: -30, 1.125, 30, 4
^text: Corridor

# ── STAFF BARRICADE POSITION (west, plaza side) ──────────────────────────
