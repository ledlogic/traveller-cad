^text: Krein's Command Post
door: -10, 4, -8, 4

door: 8, 4, 10, 4

door: -1, 4, 1, 4

# ── GOVERNOR'S OFFICE & COMM SUITE (east, plaza side) ─────────────────────
rect: 10, 4, 30, 18
^text: Governor's Office & Comm Suite
door: 18, 4, 20, 4

# ── OBSERVATION GALLERY, BAY VIEW (west + center, bay side) ───────────────
