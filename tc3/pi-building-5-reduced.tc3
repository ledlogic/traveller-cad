^opacity: 0.25
door: -16, 8.25, -14, 8.25
^opacity: 0.25
rect: -16.125, 1.125, -13.875, -1.125
^text: Elevator Lobby
door: -16, 1.125, -14, 1.125

# ── EAST TOWER (centered at x=+15, y=0) ───────────────────────────────────
rect: 6.75, -8.25, 23.25, 8.25
^opacity: 0.25
door: 14, 8.25, 16, 8.25
^opacity: 0.25
rect: 13.875, 1.125, 16.125, -1.125
