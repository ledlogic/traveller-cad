title: Submarine — Deck Plan
units: m
world: -28, -12, 28, 12
grid: 1.5
wallwidth: 0.25
wallcolor: #1e4a3d
# bow dome — flat right, dome opens left
semicircle: -16.75, -5.5, -4.75, 5.5, right, noflatwall
# main pressure hull — nowall so rect edges don't show,
# only the explicit top/bottom wall lines do
rect: -10.75, -5.5, 9.25, 5.5, nowall
# top and bottom hull walls
wall: -10.75, 5.5, 8.25, 5.5
wall: -10.75, -5.5, 8.25, -5.5
# stern dome — flat left, dome opens right
semicircle: -1.5, -5.5, 18, 5.5, left, noflatwall
label: -20.75, -1, -16.75, 1, Bow
label: -10.75, 5.5, 8.25, 8, Pressure Hull
label: 18, -1, 22, 1, Stern
wall: -11.25,5.5,-11.25,-5.5
# sliding door in the bulkhead wall
door: -11.25, 1.5, -11.25, -1.5
# ── component definitions ───────────────────────────────────────────
# chair_rect: ~0.5m square. origin at centre. back faces +Y at angle=0.
@component chair_rect
# seat body
rect: -0.22, -0.22, 0.22, 0.22
# backrest (thick bar at top)
rect: -0.22,  0.22,  0.22, 0.32
# left armrest
rect: -0.30, -0.10, -0.22, 0.22
# right armrest
rect:  0.22, -0.10,  0.30, 0.22
@end
# ── component: bed ─────────────────────────────────────────────────
# bed: 0.9m wide x 2.0m long. origin at centre. head faces +Y at angle=0.
@component bed
# outer frame
rect: -0.45, -1.00, 0.45, 1.00
# sleeping field (head side)
rect: -0.38, 0.00, 0.38, 0.88, nowall
# mid rail
line: -0.45, 0.00, 0.45, 0.00
# foot section
rect: -0.38, -0.90, 0.38, 0.00, nowall
# pillow oval
oval: -0.22, -0.72, 0.22, -0.38
@end

# ── place: name, x, y, scale, angleDeg ──────────────────────────────
place: chair_rect, -14.25, -2.25, 1, 270
place: chair_rect, -14.25, 2.25, 1, 270
place: bed, 5, 0, 1, 0
